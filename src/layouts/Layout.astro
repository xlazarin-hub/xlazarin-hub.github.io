---
import '../styles/global.css';
const { title, description } = Astro.props;
---
<!DOCTYPE html><html lang="en"><head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#101211" /><meta name="description" content={description} />
<link rel="icon" href="/mark.svg" type="image/svg+xml" /><title>{title}</title>
</head><body><a class="skip" href="#main">Skip to content</a>
<header class="shell"><a class="brand" href="/"><span aria-hidden="true" class="mark">lt</span> Lucas Tuzza</a>
<nav aria-label="Main navigation"><a href="/#work">Work</a><a href="/#about">About</a><a href="/#contact">Contact <span aria-hidden="true">↗</span></a></nav></header>
<main id="main"><slot /></main>
<footer class="shell"><a class="brand" href="/">Lucas Tuzza</a><span>São José dos Campos, BR</span><a href="#main">Back to top ↑</a></footer>
</body></html>
